{
  "schema_version": "1.0",
  "name": "Windows Quick Start",
  "description": "A single Windows Server Core container with a PowerShell command line - a sandbox for Windows command-line tasks. Needs Docker Desktop switched to Windows containers.",
  "author": "Practicum Team",
  "version": "0.1.0",
  "manual": {
    "sections": [
      {
        "id": "step-1",
        "title": "Open PowerShell",
        "content_markdown": "Start the lab, wait until the host node shows `running`, then use **Open PowerShell** in the Lab nodes table. The prompt prints the tool-install status: wait for `Practicum: tools ready`.",
        "tasks": [
          {
            "id": "done",
            "text": "Done: Open PowerShell"
          }
        ]
      },
      {
        "id": "step-2",
        "title": "Explore the sandbox",
        "content_markdown": "Try a few commands:\n\n```\nGet-ComputerInfo | Select-Object WindowsProductName, OsVersion\ngit --version\n7z\n```",
        "tasks": [
          {
            "id": "done",
            "text": "Done: Explore the sandbox"
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "host",
      "image": "mcr.microsoft.com/windows/servercore:ltsc2022",
      "resources": {
        "cpu": 2,
        "memory_mb": 2048
      },
      "os": "windows",
      "shell": "powershell",
      "command": [
        "powershell.exe",
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-EncodedCommand",
        ""
      ],
      "environment": {
        "PRACTICUM_PACKAGES": "git 7zip",
        "PRACTICUM_PACKAGE_SOURCE": "chocolatey"
      }
    }
  ],
  "networks": [
    {
      "id": "lab-net",
      "subnet": "10.92.0.0/24"
    }
  ],
  "interfaces": [
    {
      "node": "host",
      "network": "lab-net",
      "address": "10.92.0.10/24"
    }
  ]
}
